# Скопируйте в .env и при необходимости измените. Значения ниже — по умолчанию.
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader
POSTGRES_DB=trader
# Порт PostgreSQL на хосте (слушает только 127.0.0.1)
POSTGRES_PORT=5432
# Не используйте в пароле символы, требующие URL-кодирования (@ : / ?)
# pgAdmin (http://127.0.0.1:5050, без входа; учётные данные нужны только для сервера)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

