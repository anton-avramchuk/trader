# /api (REST и WebSocket) проксируется на FastAPI; адрес — переменная API_URL.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 4200;
    root /usr/share/nginx/html;

    # Имя api разрешается при каждом запросе: после пересоздания контейнера
    # его IP меняется, а nginx иначе держит адрес, найденный при старте.
    resolver 127.0.0.11 valid=10s;

    location /api/ {
        set $api_upstream ${API_URL};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
