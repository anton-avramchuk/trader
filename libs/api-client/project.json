{
  "name": "api-client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/api-client/src",
  "tags": [],
  "implicitDependencies": ["api"],
  "targets": {
    "export-schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "uv run python -m trader_api.export_openapi ../../libs/api-client/openapi.json",
        "cwd": "apps/api"
      }
    },
    "generate": {
      "executor": "nx:run-commands",
      "dependsOn": ["export-schema"],
      "options": {
        "command": "npx openapi-typescript libs/api-client/openapi.json -o libs/api-client/src/schema.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p libs/api-client/tsconfig.json",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["generate"],
      "options": {
        "command": "git diff --exit-code -- libs/api-client",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
